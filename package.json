{
  "name": "@withnicer/ui",
  "version": "0.0.0-semantic-release",
  "description": "Nicer's design system: React primitives, tokens and styles.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withnicer/ui.git"
  },
  "files": [
    "dist",
    "src/styles",
    "src/assets",
    "src/utils/dial-codes.json"
  ],
  "type": "module",
  "sideEffects": [
    "*.sass",
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.sass": "./src/styles/styles.sass",
    "./dial-codes.json": "./src/utils/dial-codes.json",
    "./fonts/*": "./src/styles/fonts/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && tsc -p tsconfig.app.json --noEmit false --emitDeclarationOnly --rootDir src --outDir dist",
    "check": "vp check",
    "dev": "vp dev",
    "fix": "vp check --fix",
    "release": "semantic-release",
    "test": "vp test run"
  },
  "dependencies": {
    "aws-rum-web": "^3.2.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "react-error-boundary": "^6.1.3",
    "react-joyride": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^26.0.1",
    "styled-components": "^6.5.3",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "styled-components": "^6.5.3"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "packageManager": "bun@1.3.14"
}
